{
    "version": 3,
    "cmakeMinimumRequired": { "major": 3, "minor": 21 },
    "configurePresets": [
      {
        "name": "default",
        "displayName": "Default (vcpkg, Debug)",
        "generator": "Ninja",
        "binaryDir": "${sourceDir}/build",
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Debug",
          "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake"
        }
      },
      {
        "name": "release",
        "displayName": "Release (vcpkg, RelWithDebInfo)",
        "inherits": "default",
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "RelWithDebInfo"
        },
        "binaryDir": "${sourceDir}/build-release"
      }
    ],
    "buildPresets": [
      { "name": "build", "configurePreset": "default" },
      { "name": "build-release", "configurePreset": "release" }
    ],
    "testPresets": []
  }
  